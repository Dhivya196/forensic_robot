<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="crime_scene">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <!-- Sunlight -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ground plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.85 0.85 0.85 1</ambient>
            <diffuse>0.85 0.85 0.85 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Crime Scene Outer Walls (8m x 6m Room) -->
    <!-- North Wall -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 3.0 1.0 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>8.2 0.2 2.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>8.2 0.2 2.0</size></box></geometry><material><ambient>0.7 0.7 0.7 1</ambient></material></visual>
      </link>
    </model>

    <!-- South Wall -->
    <model name="wall_south">
      <static>true</static>
      <pose>0 -3.0 1.0 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>8.2 0.2 2.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>8.2 0.2 2.0</size></box></geometry><material><ambient>0.7 0.7 0.7 1</ambient></material></visual>
      </link>
    </model>

    <!-- East Wall -->
    <model name="wall_east">
      <static>true</static>
      <pose>4.0 0 1.0 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.2 6.0 2.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.2 6.0 2.0</size></box></geometry><material><ambient>0.7 0.7 0.7 1</ambient></material></visual>
      </link>
    </model>

    <!-- West Wall -->
    <model name="wall_west">
      <static>true</static>
      <pose>-4.0 0 1.0 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.2 6.0 2.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.2 6.0 2.0</size></box></geometry><material><ambient>0.7 0.7 0.7 1</ambient></material></visual>
      </link>
    </model>

    <!-- Interior Crime Scene Table / Obstacle -->
    <model name="evidence_table">
      <static>true</static>
      <pose>1.5 1.0 0.4 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>1.4 0.8 0.8</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>1.4 0.8 0.8</size></box></geometry><material><ambient>0.4 0.25 0.1 1</ambient></material></visual>
      </link>
    </model>

    <!-- Partition / Divider Wall -->
    <model name="divider_wall">
      <static>true</static>
      <pose>-1.5 0.5 0.75 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.15 2.5 1.5</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.15 2.5 1.5</size></box></geometry><material><ambient>0.6 0.6 0.65 1</ambient></material></visual>
      </link>
    </model>

    <!-- Simulated Evidence Object 1 (Red stain marker on floor) -->
    <model name="evidence_stain_1">
      <static>true</static>
      <pose>2.0 -1.0 0.002 0 0 0</pose>
      <link name="link">
        <visual name="vis">
          <geometry><cylinder><radius>0.20</radius><length>0.004</length></cylinder></geometry>
          <material><ambient>0.8 0.1 0.1 1.0</ambient><diffuse>0.8 0.1 0.1 1.0</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Simulated Evidence Object 2 (Weapon-like box marker) -->
    <model name="evidence_item_2">
      <static>true</static>
      <pose>1.5 1.0 0.82 0 0 0.5</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.25 0.06 0.04</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.25 0.06 0.04</size></box></geometry>
          <material><ambient>0.1 0.1 0.1 1.0</ambient></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
